---
// Tela de login do admin. Se já houver sessão, o middleware redireciona p/ /admin.
// Layout em duas colunas no estilo PROC Manager: painel de apresentação à
// esquerda (gradiente magenta do padrão PROC) e o formulário à direita.
import AdminLayout from '../../layouts/AdminLayout.astro';

export const prerender = false;
---

<AdminLayout titulo="Entrar">
  <div class="palco">
    <!-- ===== apresentação ===== -->
    <div class="vitrine">
      <span class="brilho brilho-1"></span>
      <span class="brilho brilho-2"></span>

      <p class="marca-login">
        <span class="marca-icone">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2 2 7l10 5 10-5-10-5z" /><path d="m2 17 10 5 10-5" /><path d="m2 12 10 5 10-5" />
          </svg>
        </span>
        <span>
          <span class="logo">ACB Sul</span>
          <span class="marca-sub">Compressores · Atlas Copco</span>
        </span>
      </p>

      <div class="chamada">
        <p class="etiqueta"><span></span>Painel do catálogo</p>
        <h2>Todo o catálogo e os leads, num só lugar.</h2>
        <p class="linha">Cadastre produtos, organize categorias e acompanhe as solicitações de orçamento que chegam pelo site.</p>
      </div>
    </div>

    <!-- ===== formulário ===== -->
    <div class="area-form">
      <div class="caixa">
        <p class="marca-mobile">
          <span class="logo">ACB Sul</span>
          <span class="tag-admin">Admin</span>
        </p>

        <h1>Bem-vindo de volta</h1>
        <p class="sub">Acesso restrito — somente administradores.</p>

        <form id="form-login" novalidate>
          <label class="campo">
            E-mail
            <input type="email" name="email" required autocomplete="username" autofocus />
          </label>
          <label class="campo">
            Senha
            <span class="campo-senha">
              <input type="password" name="senha" id="senha" required autocomplete="current-password" />
              <button type="button" id="ver-senha" class="olho" aria-label="Mostrar senha" aria-pressed="false" title="Mostrar senha">
                <svg class="olho-aberto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z" /><circle cx="12" cy="12" r="3" />
                </svg>
                <svg class="olho-fechado" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden>
                  <path d="M10.6 6.2A9.9 9.9 0 0 1 12 6c6.5 0 10 6 10 6a17.6 17.6 0 0 1-3.2 3.9M6.6 6.7A17.5 17.5 0 0 0 2 12s3.5 7 10 7a9.7 9.7 0 0 0 4.6-1.1" />
                  <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" /><path d="m2 2 20 20" />
                </svg>
              </button>
            </span>
          </label>
          <p id="erro" role="alert" tabindex="-1" hidden>
            E-mail ou senha incorretos. Confira e tente de novo.
          </p>
          <button class="botao entrar" type="submit">Entrar</button>
          <noscript>
            <p class="aviso-js">O login precisa de JavaScript habilitado no navegador.</p>
          </noscript>
        </form>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  /* o <main> já vem sem limite de largura quando não há sessão
     (regra body.sem-painel no AdminLayout) */
  .palco {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    min-height: 100vh;
  }

  /* ===== apresentação ===== */
  .vitrine {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
    background: var(--accent-grad);
    color: #fff;
    padding: clamp(2rem, 4vw, 3.25rem);
  }
  /* escurece o pé do painel p/ o texto ganhar contraste sobre o magenta */
  .vitrine::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 38%, rgba(0, 0, 0, 0.42) 100%);
    pointer-events: none;
  }
  .brilho {
    position: absolute;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.13);
    filter: blur(8px);
    pointer-events: none;
  }
  .brilho-1 { width: 320px; height: 320px; top: -90px; right: -70px; animation: flutua 7s ease-in-out infinite; }
  .brilho-2 { width: 200px; height: 200px; bottom: 80px; left: -60px; animation: flutua 9s ease-in-out infinite; }
  @keyframes flutua {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-9px); }
  }

  .marca-login { position: relative; z-index: 2; display: flex; align-items: center; gap: 0.75rem; }
  /* sobre o magenta o selo é translúcido, não outro bloco de cor */
  .marca-icone {
    width: 42px;
    height: 42px;
    flex: none;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.34);
    backdrop-filter: blur(6px);
    color: #fff;
  }
  .marca-icone svg { width: 22px; height: 22px; }
  .marca-login .logo {
    display: block;
    font-family: 'Sora', var(--fonte);
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
  }
  .marca-sub { display: block; font-size: 0.75rem; color: rgba(255, 255, 255, 0.8); margin-top: 0.15rem; }

  .chamada { position: relative; z-index: 2; }
  .etiqueta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: #fff;
    background: rgba(255, 255, 255, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.28);
    backdrop-filter: blur(4px);
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    margin-bottom: 1.1rem;
  }
  .etiqueta span { width: 6px; height: 6px; border-radius: 50%; background: #fff; }
  .chamada h2 {
    font-family: 'Sora', var(--fonte);
    font-size: clamp(1.6rem, 3vw, 2.15rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 0.9rem;
  }
  .chamada .linha { color: rgba(255, 255, 255, 0.86); font-size: 0.98rem; max-width: 44ch; }

  /* ===== formulário ===== */
  .area-form { display: grid; place-items: center; padding: clamp(1.5rem, 4vw, 3rem); }
  .caixa {
    width: min(400px, 100%);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--sombra);
    padding: clamp(1.5rem, 4vw, 2.25rem);
  }
  .marca-mobile { display: none; align-items: baseline; gap: 0.5rem; margin-bottom: 1.5rem; }
  .marca-mobile .logo { font-family: 'Sora', var(--fonte); font-weight: 800; font-size: 1.15rem; color: var(--ink); }

  h1 { font-size: 1.3rem; font-weight: 700; letter-spacing: -0.01em; }
  .sub { color: var(--ink-2); font-size: 0.9rem; margin: 0.25rem 0 1.5rem; }
  .campo { display: block; margin-bottom: 1rem; }

  /* campo de senha com o botão do olho encostado na borda direita */
  .campo-senha { position: relative; display: block; }
  .campo-senha input { padding-right: 2.9rem; }
  .olho {
    position: absolute;
    top: 0.32rem; /* compensa o margin-top do input */
    right: 1px;
    bottom: 1px;
    width: 2.75rem;
    display: grid;
    place-items: center;
    border: 0;
    background: none;
    border-radius: 0 var(--r) var(--r) 0;
    color: var(--ink-3);
    cursor: pointer;
    padding: 0;
    transition: color var(--t);
  }
  .olho:hover { color: var(--ink); }
  .olho:focus-visible { outline: 3px solid var(--accent); outline-offset: -3px; }
  .olho svg { width: 20px; height: 20px; }
  .olho svg[hidden] { display: none; }
  #erro {
    color: var(--erro-ink);
    background: var(--erro-bg);
    border-radius: var(--r);
    padding: 0.6rem 0.85rem;
    font-size: 0.88rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .entrar { width: 100%; }
  .entrar:disabled { opacity: 0.6; cursor: wait; }
  .aviso-js { margin-top: 0.75rem; color: var(--erro-ink); font-size: 0.85rem; }

  /* no celular a apresentação sai e sobra só o formulário */
  @media (max-width: 860px) {
    .palco { grid-template-columns: 1fr; }
    .vitrine { display: none; }
    .marca-mobile { display: flex; }
  }
</style>

<script>
  const form = document.getElementById('form-login') as HTMLFormElement;
  const erro = document.getElementById('erro') as HTMLParagraphElement;

  // ver/ocultar senha
  const senha = document.getElementById('senha') as HTMLInputElement;
  const olho = document.getElementById('ver-senha') as HTMLButtonElement;
  const icoAberto = olho.querySelector('.olho-aberto') as SVGElement;
  const icoFechado = olho.querySelector('.olho-fechado') as SVGElement;

  olho.addEventListener('click', () => {
    const mostrando = senha.type === 'text';
    senha.type = mostrando ? 'password' : 'text';
    // em SVG a propriedade .hidden não reflete no atributo — usar toggleAttribute
    icoAberto.toggleAttribute('hidden', !mostrando);
    icoFechado.toggleAttribute('hidden', mostrando);
    const rotulo = mostrando ? 'Mostrar senha' : 'Ocultar senha';
    olho.setAttribute('aria-label', rotulo);
    olho.setAttribute('title', rotulo);
    olho.setAttribute('aria-pressed', String(!mostrando));
    senha.focus();
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    erro.hidden = true;
    const botao = form.querySelector('button')!;
    botao.disabled = true;
    botao.textContent = 'Entrando…';

    const dados = new FormData(form);
    const res = await fetch('/api/auth/sign-in/email', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: dados.get('email'), password: dados.get('senha') }),
    }).catch(() => null);

    if (res?.ok) {
      location.href = '/admin';
    } else {
      erro.hidden = false;
      erro.focus();
      botao.disabled = false;
      botao.textContent = 'Entrar';
    }
  });
</script>
