---
import '../styles/site-v2.css';
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';
import PopupBanner from '../components/PopupBanner.astro';
import { carregarConfig } from '../lib/config';
import { carregarPopupDaPagina } from '../lib/popups';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  /** atributo data-page do <body> (usado pelo site-v2.js em páginas de catálogo) */
  page?: string;
  /** conteúdo da página para o rastreio (ViewContent etc.). Sem = título da página. */
  rastreio?: { name: string; category: string; id: string };
}

// Rastreio de campanhas (public/assets/tracking.js — Framework FOP adaptado a leads)
const META_PIXEL = '1167185732664219';
const GOOGLE_ADS = {
  id: 'AW-18569368689',
  /** conversão PRINCIPAL: formulário enviado e salvo */
  lead: 'AW-18569368689/aOe_CKGYzrYdEPGoyJZF',
  /** conversão secundária: clique no WhatsApp */
  contato: 'AW-18569368689/6VzzCKSYzrYdEPGoyJZF',
};

const {
  title,
  description,
  ogImage = '/assets/hero-obra-qas.jpg',
  noindex = false,
  page,
  rastreio,
} = Astro.props;

const trackCfg = {
  pixel: META_PIXEL,
  ads: { lead: GOOGLE_ADS.lead, contato: GOOGLE_ADS.contato },
  content: rastreio,
};

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogUrl = new URL(ogImage, Astro.site).href;

// Dados de negócio expostos ao site-v2.js (config do admin + padrões de empresa.ts).
const cfg = await carregarConfig();
const biz = {
  phone: cfg.telefone,
  waNumber: cfg.whatsapp,
  email: cfg.email,
};

// Popup/banner ativo para esta URL (null = nenhum). Gerido em /admin/popup.
// ?popup-preview=N força a exibição de um popup específico (botão "Ver como fica").
const previewPopup = Number(Astro.url.searchParams.get('popup-preview') ?? 0) || undefined;
const popup = await carregarPopupDaPagina(Astro.url.pathname, previewPopup);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Google tag (gtag.js) — Google Analytics 4. Só no site público:
         o /admin usa o AdminLayout, que não carrega esta tag. -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-3LTV3XYEP2" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-3LTV3XYEP2');
      gtag('config', 'AW-18569368689', { allow_enhanced_conversions: true });
    </script>

    <!-- Meta Pixel + CAPI + eventos do funil (Framework FOP, adaptado a leads).
         SEM defer: o PageView precisa sair na carga. -->
    <script is:inline set:html={`window.ACB_TRACK=${JSON.stringify(trackCfg)};`} />
    <script src="/assets/tracking.js" is:inline></script>

    <!-- Microsoft Clarity (gravações e mapas de calor). Só no site público. -->
    <script is:inline>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "zczyinbj33");
    </script>

    <link rel="icon" type="image/svg+xml" href="/logo-acbsul-atlas-copco.svg" />

    <!-- Pré-carrega as fontes locais críticas (subset latin) para reduzir o LCP -->
    <link rel="preload" href="/fonts/sora-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ACB Sul Compressores" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <LocalBusinessSchema />
    <slot name="head" />
  </head>
  <body data-page={page}>
    <noscript><img height="1" width="1" style="display:none" alt=""
      src={`https://www.facebook.com/tr?id=${META_PIXEL}&ev=PageView&noscript=1`} /></noscript>
    <slot />

    {popup && <PopupBanner popup={popup} preview={Boolean(previewPopup)} />}

    <!-- expõe dados de negócio ao script de interações -->
    <script is:inline set:html={`window.ACB_BIZ=${JSON.stringify(biz)};`} />
    <script src="/assets/site-v2.js" is:inline></script>
  </body>
</html>
